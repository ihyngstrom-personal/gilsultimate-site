{
  "navigationFallback": { "rewrite": "/404.html", "exclude": ["/uploads/*", "*.{css,js,png,jpg,jpeg,gif,webp,svg,ico,woff2}"] },
  "responseOverrides": { "404": { "rewrite": "/404.html" } },
  "routes": [
    { "route": "/sample-page/", "redirect": "/", "statusCode": 301 },
    { "route": "/uploads/*", "headers": { "cache-control": "public, max-age=31536000, immutable" } }
  ]
}
